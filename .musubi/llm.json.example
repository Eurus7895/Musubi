{
  "//": "Musubi standalone-agent LLM endpoints — copy to .musubi/llm.json and edit.",
  "//cp": "cp .musubi/llm.json.example .musubi/llm.json",
  "//run": "agent \"your task\" --profile azure.work",
  "//schema": "Object keyed by LLM family (azure | genai_farm | openai | anthropic | ollama). Within a family, scalar values are shared defaults that every profile (a nested object) inherits; profile keys win. Reference a profile as <family>.<profile> (e.g. azure.work), or a bare name when unique. With no --profile, `default` below is used.",
  "//secrets": "Prefer `api_key_env` (the NAME of an env var holding the key) over an inline `api_key`, so the key never lives in this file. .musubi/llm.json is gitignored.",

  "default": "azure.work",

  "//azure": "Azure OpenAI (on-prem, reached via curl). Deployment lives in the URL path: {azure_endpoint}/openai/deployments/{deployment}/chat/completions?api-version=... transport='curl' routes through the system curl binary so corporate proxy / custom CA / mTLS already configured for curl are honoured.",
  "azure": {
    "transport": "curl",
    "azure_endpoint": "https://my-resource.openai.azure.com",
    "api_version": "2024-06-01",
    "api_key_env": "AZURE_OPENAI_API_KEY",
    "auth_header": "api-key",
    "//curl_extra_args": ["--cacert", "/etc/ssl/corp-ca.pem", "--proxy", "http://proxy:8080"],
    "work": { "deployment": "gpt-4o" },
    "work-mini": { "deployment": "gpt-4o-mini" }
  },

  "//genai_farm": "Gen AI Farm (on-prem gateway). Azure-style deployment-in-path URL, Bearer auth. Default transport is the openai SDK; transport='curl' is the FALLBACK for an authenticated proxy / custom CA / mTLS. proxy_user_env names the env var holding 'user:password'; it and the api-key are passed to curl on stdin so neither secret appears in argv.",
  "genai_farm": {
    "endpoint": "https://genai-farm.internal",
    "api_version": "2024-06-01",
    "api_key_env": "GENAI_FARM_API_KEY",
    "default": { "deployment": "gpt-5-nano-2025-08-07" },
    "proxied": {
      "transport": "curl",
      "deployment": "gpt-5-nano-2025-08-07",
      "proxy": "http://proxy-server:8080",
      "proxy_user_env": "GENAI_FARM_PROXY_USER"
    }
  },

  "//openai": "OpenAI cloud (SDK). For a self-hosted OpenAI-compatible gateway, add \"transport\": \"curl\" and a base_url; auth_header defaults to 'Authorization: Bearer' for this family.",
  "openai": {
    "cloud": { "model": "gpt-5-mini", "api_key_env": "OPENAI_API_KEY" }
  },

  "anthropic": {
    "cloud": { "model": "claude-haiku-4-5", "api_key_env": "ANTHROPIC_API_KEY" }
  },

  "//ollama": "Ollama (local; no key). base_url defaults to http://localhost:11434, or set $OLLAMA_HOST.",
  "ollama": {
    "local": { "model": "llama3.1" }
  }
}
