# Musubi standalone-agent external MCP servers — copy to `.musubi/mcp.toml`.
#
#   cp .musubi/mcp.toml.example .musubi/mcp.toml
#   agent "your task"                     # auto-discovers ./.musubi/mcp.toml
#   agent "your task" --mcp-config path   # or point at one explicitly
#
# Every server declared here is connected alongside Musubi's own MCP server,
# and its tools are spliced into the catalog handed to the model under a
# `<server>__<tool>` namespace (so `filesystem`'s `read_file` becomes
# `filesystem__read_file`). Tool calls are routed back to the owning server.
#
# Resolution order: --mcp-config → $MUSUBI_MCP_CONFIG → ./.musubi/mcp.toml →
# ~/.musubi/mcp.toml. With none of these present, the feature is simply off.
#
# Failure is fail-open: a server that won't launch or won't initialise is
# logged and skipped, never fatal — its tools are additive.
#
# GOVERNANCE NOTE: federated tools are NOT firewalled or audited by Musubi.
# Musubi's policy engine / evaluator firewall / audit DB gate *Musubi's* tools;
# a call to a federated tool goes straight to that server. Only add servers you
# trust. Sub-agents never receive federated tools (top-level agent only).
#
# Secrets: prefer `env_passthrough` (NAMES of parent env vars to forward) over
# literal `env` values, so keys never live in this file. `.musubi/mcp.toml` is
# gitignored.

# enabled = false   # optional master switch to turn every server off at once

# ── stdio server (the common local case) ────────────────────────────────────
# Launched as a subprocess; Musubi speaks MCP over its stdin/stdout.
[servers.filesystem]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/workspace"]
# cwd = "/path/to/workspace"
# disabled = false
# timeout_s = 30

# ── stdio server needing a secret in its environment ────────────────────────
# `env_passthrough` copies named vars from Musubi's own environment into the
# child; `env` sets literal values (env wins on a name clash).
[servers.github]
command = "docker"
args = ["run", "-i", "--rm", "ghcr.io/github/github-mcp-server"]
env_passthrough = ["GITHUB_PERSONAL_ACCESS_TOKEN"]
# env = { GITHUB_HOST = "github.example.com" }

# ── streamable-HTTP server (remote) ─────────────────────────────────────────
# Needs a recent `mcp` (streamable_http client). Mutually exclusive with
# `command` — declare exactly one transport per server.
[servers.remote]
url = "https://mcp.example.com/mcp"
# headers = { Authorization = "Bearer <token>" }
