{
  "name": "copilot-harness-extension",
  "displayName": "CopilotHarness",
  "description": "Automated 5-agent pipeline runner for GitHub Copilot Chat via CopilotHarness",
  "version": "0.1.0",
  "publisher": "copilot-harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eurus7895/CopilotHarness"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "copilot-harness.harness",
        "name": "harness",
        "fullName": "CopilotHarness",
        "description": "Runs the automated 5-agent pipeline. Usage: @harness <your request>",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "compile": "npx tsc -p ./",
    "watch": "npx tsc --watch -p ./",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.116.0",
    "typescript": "^5.4.0"
  }
}
