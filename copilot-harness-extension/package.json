{
  "name": "copilot-harness-extension",
  "displayName": "CopilotHarness",
  "description": "Automated 4-agent pipeline for GitHub Copilot Chat via CopilotHarness — inline chat rendering + sidebar Tasks view.",
  "version": "0.4.0",
  "publisher": "copilot-harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eurus7895/CopilotHarness"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "copilot-harness.harness",
        "name": "harness",
        "fullName": "CopilotHarness",
        "description": "Runs the automated 4-agent pipeline. Usage: @harness <your request>",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "copilot-harness.refreshTasks",
        "title": "Refresh",
        "category": "CopilotHarness",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-harness.openSessionArtifact",
        "title": "Open Session Artifact",
        "category": "CopilotHarness"
      },
      {
        "command": "copilot-harness.showTasks",
        "title": "Show Tasks",
        "category": "CopilotHarness",
        "icon": "$(checklist)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotHarness",
          "title": "CopilotHarness",
          "icon": "media/icons/harness.svg"
        }
      ]
    },
    "views": {
      "copilotHarness": [
        {
          "type": "tree",
          "id": "copilotHarness.tasks",
          "name": "Tasks",
          "contextualTitle": "CopilotHarness Tasks"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilot-harness.refreshTasks",
          "when": "view == copilotHarness.tasks",
          "group": "navigation"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "harness_spawn_subagent",
        "displayName": "Spawn sub-agent (CopilotHarness)",
        "modelDescription": "Spawn a read-only sub-agent (explorer, investigator, reviewer-aux, planner, coder, reviewer) with a one-sentence brief. Returns a handle_id you must pass to harness_await_subagent. Sub-agents see only the brief — no conversation history, memory, or other sub-agent results.",
        "toolReferenceName": "harness_spawn_subagent",
        "canBeReferencedInPrompt": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "role": { "type": "string" },
            "brief": { "type": "string" },
            "allowed_tools": { "type": "array", "items": { "type": "string" } },
            "output_schema": { "type": "object" }
          },
          "required": ["role", "brief"]
        }
      },
      {
        "name": "harness_await_subagent",
        "displayName": "Await sub-agent (CopilotHarness)",
        "modelDescription": "Block until a spawned sub-agent reaches a terminal state (done, failed, escalated, abandoned) or its wall-clock cap fires. Returns the sub-agent's summary + structured payload.",
        "toolReferenceName": "harness_await_subagent",
        "canBeReferencedInPrompt": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "handle_id": { "type": "string" },
            "max_wait_s": { "type": "number" }
          },
          "required": ["handle_id"]
        }
      },
      {
        "name": "harness_list_subagents",
        "displayName": "List spawnable sub-agents (CopilotHarness)",
        "modelDescription": "List the sub-agent roles the orchestrator is permitted to spawn, with each role's tool allow-list. Call before spawning when unsure which role fits.",
        "toolReferenceName": "harness_list_subagents",
        "canBeReferencedInPrompt": false,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ]
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc --watch -p ./",
    "build:server": "bash scripts/build-server.sh",
    "build:assets": "bash scripts/copy-assets.sh",
    "build": "bash scripts/build-parallel.sh",
    "build:serial": "npm run build:server && npm run build:assets && npm run compile",
    "package": "npm run build && vsce package",
    "install:vsix": "bash scripts/install-vsix.sh",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "test:watch": "node --test --watch --import tsx 'src/**/*.test.ts'",
    "all": "npm run setup && npm run package && npm run install:vsix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
