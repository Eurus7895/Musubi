{
  "name": "copilot-harness-extension",
  "displayName": "CopilotHarness",
  "description": "Automated 5-agent pipeline runner for GitHub Copilot Chat via CopilotHarness",
  "version": "0.1.0",
  "publisher": "copilot-harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eurus7895/CopilotHarness"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "copilot-harness.harness",
        "name": "harness",
        "fullName": "CopilotHarness",
        "description": "Runs the automated 5-agent pipeline. Usage: @harness <your request>",
        "isSticky": true
      }
    ],
    "mcpServers": {
      "copilot-harness": {
        "label": "CopilotHarness",
        "command": "node",
        "args": ["${extensionPath}/bin/launch.js", "serve"],
        "env": {
          "HARNESS_ROOT": "${extensionPath}"
        }
      }
    }
  },
  "scripts": {
    "compile": "npx tsc -p ./",
    "watch": "npx tsc --watch -p ./",
    "build:server": "bash scripts/build-server.sh",
    "build:assets": "bash scripts/copy-assets.sh",
    "build": "npm run build:server && npm run build:assets && npm run compile",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.4.0"
  }
}
