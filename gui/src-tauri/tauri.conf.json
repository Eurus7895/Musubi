{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musubi Console",
  "version": "0.1.0",
  "identifier": "app.musubi.console",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npx vite --host 127.0.0.1",
    "beforeBuildCommand": "npx tauri icon src-tauri/icons/icon.png && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Musubi · 結び",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
